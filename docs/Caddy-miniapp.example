{
    admin off
    auto_https off
    servers {
        protocols h1 h2
        max_header_size 32KB
    }
}

https://{$MINI_HOST}:443 {
    tls {$CREDENTIALS_DIRECTORY}/cert.pem {$CREDENTIALS_DIRECTORY}/key.pem
    encode gzip zstd
    header -Server
    request_body {
        max_size 6MB
    }
    handle /api/auth/* {
        respond 404
    }
    @mini path /app /admin-app /mini-api/* /static/* /brand/logo
    handle @mini {
        reverse_proxy 127.0.0.1:18080
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:18080
    }
    respond 404
}
