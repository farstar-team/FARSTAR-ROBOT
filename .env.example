# Generate secrets with: python -m farstar setup
APP_NAME=Farstar
BOT_TOKEN=
ADMIN_IDS=[]
CLIENT_NAME_PREFIX=FARSTAR_
CLIENT_NUMBER_START=405
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_PATH=data/farstar.db
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
MINI_APP_URL=
ADMIN_MINI_APP_URL=
COOKIE_SECURE=false
DEMO=false
# XTR = Telegram Stars. IRT = toman (manual payments, optional).
CURRENCY=XTR
MANUAL_PAYMENTS=false
CARD_NUMBER=
CARD_HOLDER=
REQUIRED_CHANNEL=
CHANNEL_URL=
SUPPORT_USERNAME=
REFERRAL_PERCENT=10
TRIAL_ENABLED=true
TRIAL_GB=1
TRIAL_HOURS=24
WORKER_INTERVAL=10
BACKUP_HOURS=24
